# AquaTrace Configuration Template
# Copy this file to .env and customize as needed.

# Database: PostgreSQL + PostGIS (Production / Local PostGIS)
# Example: postgresql://postgres:postgres@localhost:5432/aquatrace
DATABASE_URL=sqlite:///aquatrace.db

# Microsoft Planetary Computer API Key (Optional, raises rate limits)
PC_API_KEY=

# STAC Catalog API URLs
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1

# DEM Configuration: copernicus-dem-glo-30 or srtm
DEM_PROVIDER=copernicus-dem-glo-30
